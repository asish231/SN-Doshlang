// -----------------------------------------------------------------------------
// selfhost/lexer.sn — a TOKENIZER for SNlang, written IN SNlang.
//
// This is the first real self-hosting component (roadmap milestone M3: "Port the
// lexer", token-dump mode). It is compiled by the current assembly `snc`
// (Stage 0) and, given a `.sn` source path, prints one token per line as
// "KIND<TAB>text", plus a final "tokens: N" count.
//
// It exercises exactly the language features a self-hosted front-end needs and
// that are now verified in `snc`:
//   - argv(i) / file_read(path)            — receive and read the source
//   - s[i], s.length(), s.slice(a, b)      — scan and extract lexemes
//   - ord(c)                               — NEW: character-code classification
//   - functions, while, if/else, and/or    — control flow
//
// KINDS: NUM (integer), ID (identifier/keyword), STR (string literal),
//        OP (one- or two-char operator/punctuation).
//
// Not yet handled (intentionally, for a first stage): float/decimal literals,
// escape sequences inside strings, and comments. These are follow-ups for M3.
// -----------------------------------------------------------------------------

fn is_space(c: int) -> int {
    if (c == 32 or c == 9 or c == 10 or c == 13) { return 1 }
    return 0
}

fn is_digit(c: int) -> int {
    if (c >= 48 and c <= 57) { return 1 }
    return 0
}

fn is_alpha(c: int) -> int {
    if (c >= 65 and c <= 90) { return 1 }
    if (c >= 97 and c <= 122) { return 1 }
    if (c == 95) { return 1 }
    return 0
}

fn is_alnum(c: int) -> int {
    if (is_digit(c) == 1) { return 1 }
    if (is_alpha(c) == 1) { return 1 }
    return 0
}

// Is (a, b) one of SNlang's two-character operators? Returns 1 if so.
fn is_two_char_op(a: int, b: int) -> int {
    if (a == 61 and b == 61) { return 1 }   // ==
    if (a == 33 and b == 61) { return 1 }   // !=
    if (a == 60 and b == 61) { return 1 }   // <=
    if (a == 62 and b == 61) { return 1 }   // >=
    if (a == 45 and b == 62) { return 1 }   // ->
    if (a == 43 and b == 61) { return 1 }   // +=
    if (a == 45 and b == 61) { return 1 }   // -=
    if (a == 43 and b == 43) { return 1 }   // ++
    if (a == 45 and b == 45) { return 1 }   // --
    if (a == 38 and b == 38) { return 1 }   // &&
    if (a == 124 and b == 124) { return 1 } // ||
    if (a == 42 and b == 42) { return 1 }   // **
    return 0
}

fn main() {
    str path = argv(1)
    str src = file_read(path)
    int n = src.length()

    int i = 0
    int count = 0

    // These are declared once and reused: SNlang's duplicate-variable check is
    // per-function (not per-block), so re-declaring them inside each branch
    // below would be rejected.
    int c = 0
    int c2 = 0
    int start = 0
    str tok = ""

    while (i < n) {
        c = ord(src[i])

        if (is_space(c) == 1) {
            i += 1
        } else {
            if (is_digit(c) == 1) {
                // number literal
                start = i
                while (i < n and is_digit(ord(src[i])) == 1) {
                    i += 1
                }
                tok = src.slice(start, i)
                print("NUM\t" + tok)
                count += 1
            } else {
                if (is_alpha(c) == 1) {
                    // identifier / keyword
                    start = i
                    while (i < n and is_alnum(ord(src[i])) == 1) {
                        i += 1
                    }
                    tok = src.slice(start, i)
                    print("ID\t" + tok)
                    count += 1
                } else {
                    if (c == 34) {
                        // string literal: consume through the closing quote
                        start = i
                        i += 1
                        while (i < n and ord(src[i]) != 34) {
                            i += 1
                        }
                        i += 1
                        tok = src.slice(start, i)
                        print("STR\t" + tok)
                        count += 1
                    } else {
                        // operator / punctuation: prefer a two-char operator
                        start = i
                        c2 = 0
                        if (i + 1 < n) {
                            c2 = ord(src[i + 1])
                        }
                        if (is_two_char_op(c, c2) == 1) {
                            i += 2
                        } else {
                            i += 1
                        }
                        tok = src.slice(start, i)
                        print("OP\t" + tok)
                        count += 1
                    }
                }
            }
        }
    }

    print("tokens: " + str(count))
}
