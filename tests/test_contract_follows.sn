contract Drawable {
    fn draw()
}

contract Resizable {
    fn resize()
}

blueprint Circle follows Drawable {
    int radius

    fn draw() {
        print("Drawing Circle")
    }
}

blueprint Square follows Drawable, Resizable {
    int side

    fn draw() {
        print("Drawing Square")
    }

    fn resize() {
        print("Resizing Square")
    }
}

fn main() {
    new Circle c(radius: 5)
    c.draw()
    new Square s(side: 10)
    s.draw()
    s.resize()
}
