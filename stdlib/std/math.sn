fn abs(int x) -> int {
    if (x < 0) {
        return 0 - x
    }
    return x
}

fn max(int a, int b) -> int {
    if (a > b) {
        return a
    }
    return b
}

fn min(int a, int b) -> int {
    if (a < b) {
        return a
    }
    return b
}

fn pow(int base, int exp) -> int {
    if (exp <= 0) {
        return 1
    }
    return base * pow(base, exp - 1)
}

fn clamp(int n, int lo, int hi) -> int {
    if (n < lo) {
        return lo
    }
    if (n > hi) {
        return hi
    }
    return n
}

fn sign(int x) -> int {
    if (x < 0) {
        return -1
    }
    if (x > 0) {
        return 1
    }
    return 0
}

// Greatest common divisor (Euclid). gcd(0, 0) == 0.
fn gcd(int a, int b) -> int {
    int x = abs(a)
    int y = abs(b)
    while (y != 0) {
        int t = y
        y = x % y
        x = t
    }
    return x
}

// Least common multiple. lcm(x, 0) == 0.
fn lcm(int a, int b) -> int {
    if (a == 0) {
        return 0
    }
    if (b == 0) {
        return 0
    }
    return abs(a * b) / gcd(a, b)
}

// n! for n >= 0 (1 for n <= 1).
fn factorial(int n) -> int {
    if (n <= 1) {
        return 1
    }
    return n * factorial(n - 1)
}

fn isEven(int n) -> bool {
    if (n % 2 == 0) {
        return true
    }
    return false
}

fn isOdd(int n) -> bool {
    if (n % 2 == 0) {
        return false
    }
    return true
}

// Trial-division primality test.
fn isPrime(int n) -> bool {
    if (n < 2) {
        return false
    }
    int i = 2
    while (i * i <= n) {
        if (n % i == 0) {
            return false
        }
        i += 1
    }
    return true
}

// Integer square root: largest r with r*r <= n (0 for n < 0).
fn isqrt(int n) -> int {
    if (n < 0) {
        return 0
    }
    int r = 0
    while ((r + 1) * (r + 1) <= n) {
        r += 1
    }
    return r
}
