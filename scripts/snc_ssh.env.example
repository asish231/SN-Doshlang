# Copy to snc_ssh.env and fill in. snc_ssh.env is gitignored — never commit it.
#
# Optional: overrides (defaults shown in Python scripts otherwise)
SNC_SSH_HOST=192.168.0.113
SNC_SSH_USER=your_username
SNC_SSH_PASSWORD=your_password
# Optional: workspace on the Mac
# SNC_SSH_REMOTE_DIR=/Users/your_username/programming/snc
